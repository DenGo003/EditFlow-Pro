+ // Launch the exact PowerShell installer used for the successful manual repairs.
+ // Absolute path avoids CEP's sometimes-restricted PATH; stdout/stderr are persistent.
+ const systemRoot=process.env.SystemRoot||process.env.WINDIR||'C:\\Windows';
+ const ps=n.path.join(systemRoot,'System32','WindowsPowerShell','v1.0','powershell.exe');
+ if(!n.fs.existsSync(ps))throw Error('Windows PowerShell not found: '+ps);
+ const logPath=n.path.join(process.env.LOCALAPPDATA,'EditFlowPro','online-update-launch.log');
+ const fd=n.fs.openSync(logPath,'a');
+ n.fs.writeSync(fd,'\nLaunching '+latestPackage.tag+' at '+new Date().toISOString()+'\n');
+ let child;
+ try {
+  child=n.cp.spawn(ps,['-NoLogo','-NoProfile','-NonInteractive','-ExecutionPolicy','Bypass','-File',worker,'-Archive',file,'-Tag',latestPackage.tag],{
+   detached:true,windowsHide:true,stdio:['ignore',fd,fd]
+  });
+ } catch(e){n.fs.closeSync(fd);throw Error('Failed to launch PowerShell installer: '+e.message);}
+ n.fs.closeSync(fd);
+ await new Promise((resolve,reject)=>{
+  let settled=false;
+  child.once('spawn',()=>{settled=true;resolve();});
+  child.once('error',e=>{try{n.fs.appendFileSync(logPath,'Spawn error: '+e.message+'\n');}catch(ignore){}
+   if(!settled){settled=true;reject(Error('PowerShell installer did not start: '+e.message));}});
+  child.once('exit',(code)=>{if(code!==0)try{n.fs.appendFileSync(logPath,'Installer process exited with code '+code+'; see online-update.log\n');}catch(ignore){}});
+ });
+ if(!child.pid)throw Error('PowerShell installer did not return a process ID.');
+ child.unref();
