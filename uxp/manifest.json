{
  "manifestVersion": 5,
  "id": "com.editflow.pro.uxp.dev",
  "name": "EditFlow Pro \u2014 UXP Preview",
  "version": "1.0.1",
  "main": "index.html",
  "host": {
    "app": "premierepro",
    "minVersion": "25.6.2"
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "editflow",
      "label": {
        "default": "EditFlow Pro Preview"
      },
      "minimumSize": {
        "width": 300,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 380,
        "height": 650
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": [
        "http://127.0.0.1:8765"
      ]
    },
    "localFileSystem": "request",
    "launchProcess": {
      "extensions": [
        ".cmd"
      ]
    }
  }
}
