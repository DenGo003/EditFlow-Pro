@echo off
setlocal
rem Reuse the existing CEP installation configuration. Never change its token or venv.
powershell.exe -NoLogo -NoProfile -Command "try { $ErrorActionPreference='Stop'; $appDir=Join-Path $env:LOCALAPPDATA 'EditFlowPro'; $configFile=Join-Path $appDir 'cep-launcher.json'; if (!(Test-Path -LiteralPath $configFile)) { throw 'Existing EditFlow installation configuration was not found.' }; $cfg=Get-Content -LiteralPath $configFile -Raw | ConvertFrom-Json; $root=[string]$cfg.backendRoot; if (!$root -or !(Test-Path -LiteralPath (Join-Path $root 'backend\server.py'))) { throw 'Configured backend source was not found.' }; $python=[string]$cfg.backendPython; if (!$python) { $python=Join-Path $root '.venv\Scripts\python.exe' }; if (!(Test-Path -LiteralPath $python)) { throw 'Configured Python environment was not found.' }; $probe=New-Object System.Net.Sockets.TcpClient; try { $pending=$probe.ConnectAsync('127.0.0.1',8765); $occupied=$pending.Wait(500) -and $probe.Connected } catch { $occupied=$false } finally { $probe.Dispose() }; if ($occupied) { Write-Host 'Port 8765 is already in use. No second backend started. The panel will check authentication.'; exit 0 }; $work=[string]$cfg.workRoot; if (!$work) { $work='G:\EditFlowPro' }; if (!(Test-Path -LiteralPath $work)) { throw 'Configured work folder is unavailable.' }; $env:EDITFLOW_WORK_ROOT=$work; $env:HF_HUB_OFFLINE='1'; $env:HF_HUB_DISABLE_TELEMETRY='1'; $env:PATH=(Join-Path $root 'tools\ffmpeg\bin')+[IO.Path]::PathSeparator+$env:PATH; Set-Location -LiteralPath $root; Write-Host 'EditFlow backend running. Keep this window open.'; & $python -m backend.server --root $appDir; if ($LASTEXITCODE -ne 0) { throw ('Backend exited with code '+$LASTEXITCODE) } } catch { Write-Host ('EditFlow startup failed: '+$_.Exception.Message); exit 1 }"
if errorlevel 1 pause
endlocal
